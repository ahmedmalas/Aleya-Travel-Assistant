# Travel Buddy — production Supabase target
# Copy to `.env.local` for local development. Never commit secrets.

VITE_SUPABASE_URL=https://jtktojbvbmiewpntpvhe.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Legacy alias (older builds / back-compat):
# VITE_SUPABASE_ANON_KEY=sb_publishable_your_key
VITE_SUPABASE_PROJECT_REF=jtktojbvbmiewpntpvhe
VITE_APP_URL=https://travel-buddy-assistant-ai.vercel.app

# --- Phase 5 architecture Turn Governor (Draft preview only) ---
# Reversible behaviour switch.
# - Explicit: VITE_ARCHITECTURE_GOVERNOR_SWITCH=true|false (wins)
# - Default: ON when Vercel builds a Preview (VERCEL_ENV=preview)
# - Production / local: OFF unless explicitly set to true
# Never set VITE_ARCHITECTURE_GOVERNOR_SWITCH=true on Production.
# VITE_ARCHITECTURE_GOVERNOR_SWITCH=false

# --- Semantic conversation interpretation (server-side only) ---
# Used by /api/conversation/interpret via Vercel AI Gateway.
# On Vercel, OIDC can replace the key. Never put this in VITE_*.
# AI_GATEWAY_API_KEY=

# --- Travel provider integration layer (mock-only until suppliers approved) ---
# Toggle suppliers without code changes: enabled | disabled | pending
# VITE_TRAVEL_PROVIDER_AMADEUS=enabled
# VITE_TRAVEL_PROVIDER_DUFFEL=disabled
# VITE_TRAVEL_PROVIDER_BOOKING_COM=pending
# VITE_TRAVEL_PROVIDER_VIATOR=enabled
# Optional public identifiers only (never put private API secrets in VITE_*):
# VITE_TRAVEL_AMADEUS_CLIENT_ID=
# VITE_TRAVEL_BOOKING_AFFILIATE_ID=
# VITE_TRAVEL_VIATOR_PARTNER_ID=
# VITE_TRAVEL_LIVE_PROXY_ENABLED=false
#
# Server-side only (NOT for Vite / frontend bundles) when live integrations are approved:
# AMADEUS_CLIENT_ID=
# AMADEUS_CLIENT_SECRET=
# DUFFEL_ACCESS_TOKEN=
# BOOKING_COM_API_KEY=
# EXPEDIA_RAPID_API_KEY=
# EXPEDIA_RAPID_SHARED_SECRET=
# HOTELBEDS_API_KEY=
# HOTELBEDS_SECRET=
# VIATOR_API_KEY=
